# Local development environment variables
# Copy this to .env and customize as needed

# These are used by docker-compose for the PostgreSQL container
POSTGRES_USER=copypasta
POSTGRES_PASSWORD=copypasta
POSTGRES_DB=copypasta

# This is used by the backend server to connect to PostgreSQL
# (docker-compose sets this automatically from the vars above)
# DATABASE_URL=postgres://copypasta:copypasta@localhost:5432/copypasta?sslmode=disable

# --- Rate Limiting ---
# Max requests per IP per minute for /api/convert (default: 10)
# RATE_LIMIT_CONVERT=10
# Max requests per IP per minute for all other API endpoints (default: 100)
# RATE_LIMIT_API=100

# --- Observability (uncomment when using: docker compose --profile observability up) ---
# Enables the /metrics endpoint on the backend for Prometheus scraping
# EXPOSE_METRICS=true
# Grafana admin password
# GF_SECURITY_ADMIN_PASSWORD=changeme
